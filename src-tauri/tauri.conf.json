{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AntiProcrastinator",
  "version": "0.2.0",
  "identifier": "com.antiprocrastinator",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AntiProcrastinator",
        "width": 1280,
        "height": 800,
        "minWidth": 540,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
